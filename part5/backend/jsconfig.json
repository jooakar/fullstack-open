{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "checkJs": true,
    "strict": false,
    "noImplicitAny": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
  },
  "include": ["**/*.js"],
  "exclude": ["node_modules"]
}
